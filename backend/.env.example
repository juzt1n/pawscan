PORT=3001
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=pawscan

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-32-plus-chars

# Your private Hugging Face Space (no trailing slash) and a READ access token
MODEL_URL=https://YOUR-USERNAME-YOUR-SPACE.hf.space
HF_TOKEN=hf_xxxxxxxxxxxxxxxx

# Used only by `npm run seed` to create the admin account
ADMIN_EMAIL=admin@pawscan.demo
ADMIN_PASSWORD=choose-a-strong-password
